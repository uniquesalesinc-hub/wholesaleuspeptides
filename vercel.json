{
  "rewrites": [
    { "source": "/catalog", "destination": "/index.html" },
    { "source": "/white-label", "destination": "/index.html" },
    { "source": "/standards", "destination": "/index.html" },
    { "source": "/batch-verification", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/order/:token", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/admin/orders", "destination": "/index.html" },
    { "source": "/admin/orders/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
