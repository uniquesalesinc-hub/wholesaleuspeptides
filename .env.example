# Web3Forms access key for the Partner Access lead form (src/components/PartnerAccessModal.jsx).
# Get a real key by visiting https://web3forms.com/ and verifying support@wholesaleuspeptides.com,
# then set VITE_WEB3FORMS_ACCESS_KEY in your local .env and in your Vercel project's
# Environment Variables before launch. Until replaced, lead emails will not deliver,
# but the partner unlock flow itself still works.
VITE_WEB3FORMS_ACCESS_KEY=PLACEHOLDER_REPLACE_BEFORE_LAUNCH
