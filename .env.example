# Web3Forms access key for the Partner Access lead form (src/components/PartnerAccessModal.jsx).
# Get a real key by visiting https://web3forms.com/ and verifying support@wholesaleuspeptides.com,
# then set VITE_WEB3FORMS_ACCESS_KEY in your local .env and in your Vercel project's
# Environment Variables before launch. Until replaced, lead emails will not deliver,
# but the partner unlock flow itself still works.
VITE_WEB3FORMS_ACCESS_KEY=PLACEHOLDER_REPLACE_BEFORE_LAUNCH

# Custom Production order workflow (Phase 1) — Supabase + Resend.
# Supabase's NEW API key format: VITE_SUPABASE_PUBLISHABLE_KEY is
# client-safe (used only for admin Auth, never for direct table access —
# see src/lib/supabaseClient.js). SUPABASE_SECRET_KEY is server-only, read
# by Vercel serverless functions (api/_lib/supabaseAdmin.js) and MUST
# NEVER be given a VITE_ prefix, or Vite will bundle it into client JS.
VITE_SUPABASE_URL=PLACEHOLDER_REPLACE_BEFORE_LAUNCH
VITE_SUPABASE_PUBLISHABLE_KEY=PLACEHOLDER_REPLACE_BEFORE_LAUNCH
SUPABASE_SECRET_KEY=PLACEHOLDER_REPLACE_BEFORE_LAUNCH

# Resend — transactional email for the order-status notifications
# (api/_lib/resend.js). RESEND_FROM_EMAIL requires a verified sending
# domain in Resend.
RESEND_API_KEY=PLACEHOLDER_REPLACE_BEFORE_LAUNCH
RESEND_FROM_EMAIL=orders@wholesaleuspeptides.com
