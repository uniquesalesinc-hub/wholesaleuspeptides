# --- Bridge server (server.js) — on Render these are set in the dashboard ---
# Random secret, at least 32 characters (openssl rand -hex 32). Signs sign-in tokens.
BRIDGE_TOKEN=
# Password you type when connecting Grok
OWNER_PASSWORD=
# Anthropic API key used by Claude Code
ANTHROPIC_API_KEY=
# Fine-grained GitHub token: this repo only, Contents read & write
GITHUB_TOKEN=
GITHUB_REPO=uniquesalesinc-hub/wholesaleuspeptides
BASE_BRANCH=main
WORK_BRANCH=grok-changes
# Where the repo is cloned
REPO_DIR=./repo
PORT=8787
# Public address of this server (Render sets RENDER_EXTERNAL_URL automatically)
# PUBLIC_URL=https://example.onrender.com
MAX_BUDGET_USD=3
TASK_TIMEOUT_MS=900000

# --- Example API client (grok-client.js) ---
XAI_API_KEY=
GROK_MODEL=grok-4
BRIDGE_URL=http://localhost:8787
