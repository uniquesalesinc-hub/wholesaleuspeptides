# --- Bridge server (server.js) ---
# Shared secret Grok must send as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
BRIDGE_TOKEN=
# Anthropic API key used by Claude Code
ANTHROPIC_API_KEY=
# Absolute path to a git checkout of this repo that Claude Code will work in
REPO_DIR=/srv/wholesaleuspeptides
PORT=8787
# Per-task limits
MAX_BUDGET_USD=2
TASK_TIMEOUT_MS=600000
# Optional: override which tools Claude may use (comma-separated). Default allows
# reading/editing files, git status/diff/log and npm run build — no push.
# ALLOWED_TOOLS=Read,Grep,Glob,Edit,Write,Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(npm run build:*)

# --- Example Grok client (grok-client.js) ---
XAI_API_KEY=
GROK_MODEL=grok-4
BRIDGE_URL=http://localhost:8787
